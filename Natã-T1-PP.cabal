-- Initial Natã-T1-PP.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                Natas-T1-PP
version:             0.1.0.0
-- synopsis:
-- description:
license:             BSD3
license-file:        LICENSE
author:              NatasFX
maintainer:          nataschmitt02@gmail.com
-- copyright:
-- category:
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md
cabal-version:       >=1.10

executable Natã-T1-PP
  main-is:             Main.hs
  other-modules:       AudioTiming, CudaRender, DeepZoom
  -- other-extensions:
  build-depends:       base >=4.12 && <4.13, JuicyPixels, ffmpeg-light, WAVE, fft, carray, array, process, parallel, vector
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options: -threaded -rtsopts -O3
  extra-lib-dirs:      cuda
  extra-libraries:     mandelbrot_cuda

test-suite deep-zoom-tests
  type:                exitcode-stdio-1.0
  main-is:             DeepZoomSpec.hs
  other-modules:       AudioTiming, DeepZoom
  hs-source-dirs:      test, src
  build-depends:       base >=4.12 && <4.13, WAVE, fft, carray, array, vector
  default-language:    Haskell2010
